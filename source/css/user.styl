//customize your own CSS for page display

.writing-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 1rem
  margin 1.5rem 0 2rem

.writing-card
  border 1px solid #e2e5e8
  border-radius 6px
  padding 2.0rem 1rem 1rem
  background #fff

  h3
    margin .2rem 0 .6rem
    font-size 2rem

  p
    margin .4rem 0

  time
    display block
    color #7a8288
    font-size 1.3rem
    margin -.2rem 0 .7rem

  a
    display inline-block
    margin-top .8rem
    color #096494
    font-weight 600
    text-decoration none

    &:hover
      text-decoration underline

.writing-kicker
  color #c62641
  font-size 1.3rem
  font-weight 700
  letter-spacing 0
  text-transform uppercase
  margin 1.1rem 0 .6rem

@media (max-width: 900px)
  .writing-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

@media (max-width: 600px)
  .writing-grid
    grid-template-columns 1fr

.writing-list
  border-top 1px solid #e2e5e8
  margin 1rem 0 2rem

.writing-row
  display block
  padding .9rem 0
  border-bottom 1px solid #e2e5e8
  color #494e52
  text-decoration none

  span
    display block
    color #7a8288
    font-size 1.3rem
    margin-bottom .2rem

  strong
    color #222
    font-size 1.7rem
    font-weight 600

  &:hover strong
    color #096494

.make-section
  border-top 1px solid #e2e5e8
  padding 2rem 0 1.6rem

  h3
    margin .2rem 0 .7rem
    font-size 2.2rem

  p
    margin .4rem 0

.make-links
  margin-top .9rem

  a
    color #1353d7
    font-weight 600
    text-decoration none

    &:hover
      text-decoration underline

.art-section
  border-top 1px solid #e2e5e8
  padding 1.7rem 0 .5rem

  h3
    margin 0 0 1rem
    font-size 2.2rem

.art-gallery
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 1rem
  margin 0 0 2rem

  figure
    margin 0

  figcaption
    color #7a8288
    font-size 1.35rem
    margin-top .45rem

  img
    width 100%
    aspect-ratio 4 / 3
    display block
    object-fit cover
    border 1px solid #e2e5e8
    border-radius 6px

.gallery-thumb
  display block
  cursor zoom-in

  &:hover img
    border-color #096494

.lightbox
  position fixed
  inset 0
  display none
  align-items center
  justify-content center
  padding 3rem
  background rgba(0, 0, 0, .82)
  z-index 1000

  &:target,
  &.is-open
    display flex

  img
    max-width min(100%, 1100px)
    max-height 85vh
    object-fit contain
    border-radius 4px
    background #fff

.lightbox-close
  position absolute
  top 1.2rem
  right 1.4rem
  color #fff
  font-size 1.4rem
  font-weight 700
  text-decoration none
  border 1px solid rgba(255, 255, 255, .55)
  border-radius 999px
  padding .35rem .75rem

  &:hover
    background rgba(255, 255, 255, .14)

@media (max-width: 900px)
  .art-gallery
    grid-template-columns repeat(2, minmax(0, 1fr))

@media (max-width: 600px)
  .art-gallery
    grid-template-columns 1fr

.music-list
  display grid
  gap .9rem
  margin 1.5rem 0 2rem

.music-track
  display grid
  grid-template-columns 132px 1fr
  gap 3rem
  align-items start
  border 1px solid #e2e5e8
  border-radius 8px
  padding .9rem
  background #f3f5f7
  color #222
  box-shadow 0 6px 16px rgba(0, 0, 0, .08)

  h3
    margin .15rem 0 .6rem
    color #111
    font-size 2.2rem

  audio
    width 100%
    display block

.track-player
  background #fff
  border 1px solid #d5dbe1
  border-radius 8px
  padding .45rem
  margin .25rem 0 .85rem
  box-shadow inset 0 1px 0 rgba(255, 255, 255, .7), 0 1px 3px rgba(0, 0, 0, .06)

  p
    margin .45rem 0 0

.track-cover
  width 132px
  aspect-ratio 1 / 1
  object-fit cover
  border-radius 6px
  box-shadow 0 6px 14px rgba(0, 0, 0, .14)
  position sticky
  top 2.6rem
  margin-top 4rem

.track-body
  min-width 0

.track-type
  color #096494
  font-size 1.2rem
  font-weight 700
  letter-spacing 0
  text-transform uppercase

.track-story
  color #494e52
  line-height 1.45

.track-unavailable
  color #7a8288
  font-style italic
  margin .3rem 0 .8rem

.lyrics-panel
  margin-top .9rem

  summary
    display inline-block
    border 1px solid #096494
    border-radius 999px
    padding .35rem .8rem
    color #096494
    cursor pointer
    font-size 1.35rem
    font-weight 700
    list-style none
    list-style-type none

    &::-webkit-details-marker
      display none

    &::marker
      content ''

  &[open] summary
    background #096494
    color #fff
    margin-bottom .4rem

.lyrics-text
  margin .8rem 0 0
  padding 1rem
  max-height 24rem
  overflow auto
  color #494e52
  font-family "Times New Roman", FangSong, STFangsong, sans-serif
  font-size 1.6rem
  line-height 1.5
  white-space pre-wrap
  background #fff
  border 1px solid #e2e5e8
  border-radius 6px

@media (max-width: 600px)
  .music-track
    grid-template-columns 1fr

  .track-cover
    width 100%
    max-width 260px
    position static
    margin-top 0
